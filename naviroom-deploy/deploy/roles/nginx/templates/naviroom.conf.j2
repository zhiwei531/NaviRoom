server {
    listen 80;
    server_name {{ naviroom_domain }} {{ naviroom_domain_www }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ naviroom_domain }} {{ naviroom_domain_www }};

    ssl_certificate     {{ naviroom_tls_cert_path }};
    ssl_certificate_key {{ naviroom_tls_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root {{ naviroom_frontend_web_root }};
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:{{ naviroom_api_port }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /recommend/ {
        proxy_pass http://127.0.0.1:{{ naviroom_api_port }}/recommend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20m;
    }
}
